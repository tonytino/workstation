#!/usr/bin/env bash
# chezmoi modify_ script for ~/.claude/settings.json
#
# chezmoi pipes the CURRENT file contents on stdin (empty if the file doesn't
# exist) and uses our stdout as the new contents. We merge only the keys we
# want to manage and preserve everything else — notably runtime keys that
# Claude Code writes itself (feedbackSurveyState, etc.), which would otherwise
# cause perpetual `chezmoi status` drift.
set -euo pipefail

# The subset of settings we manage. Deep-merged over whatever already exists.
# Object keys merge; the permissions.allow array is replaced wholesale so this
# list stays authoritative. Hooks are deliberately NOT in here: arrays are
# replaced by the merge, which would clobber hooks other tools (e.g. peon-ping)
# register in the same file. See HOOK_ENTRY below.
read -r -d '' MANAGED <<'JSON' || true
{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh label list:*)",
      "Bash(pnpm check:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm exec vitest run:*)",
      "Bash(pnpm exec biome check:*)"
    ]
  },
  "attribution": {
    "pr": "🤖 Anthony's Agent"
  },
  "theme": "dark-daltonized",
  "voiceEnabled": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  }
}
JSON

# PreToolUse hook that enforces agent attribution (script ships via
# home/dot_claude/hooks/). Matcher is a regex; the script itself exits fast for
# out-of-scope tools. Built as a literal so the fresh-machine path works without jq.
HOOK_CMD="${HOME}/.claude/hooks/agent-attribution.sh"
HOOK_ENTRY="{\"matcher\": \"Bash|mcp__.*\", \"hooks\": [{\"type\": \"command\", \"command\": \"${HOOK_CMD}\", \"timeout\": 10}]}"

existing="$(cat)"

# Fresh machine (no existing file): nothing to preserve, so emit the managed
# config plus the hook registration verbatim (no jq needed).
if [ -z "${existing//[[:space:]]/}" ]; then
  # Splice the hooks object in before MANAGED's closing brace.
  body="${MANAGED%\}}"
  printf '%s,\n  "hooks": {\n    "PreToolUse": [\n      %s\n    ]\n  }\n}\n' "${body%$'\n'}" "${HOOK_ENTRY}"
  exit 0
fi

# An existing file is present but jq isn't installed yet (chezmoi apply runs
# before the Brewfile stage installs jq), so we can't safely deep-merge. Refuse
# to clobber the user's file: pass it through unchanged. A later `chezmoi apply`
# (once jq exists) will perform the merge.
if ! command -v jq >/dev/null 2>&1; then
  printf '%s' "${existing}"
  exit 0
fi

# jq is available and there's an existing file: deep-merge managed keys over it,
# preserving any runtime-written keys. Then append our PreToolUse hook unless an
# entry already runs agent-attribution.sh (idempotent; leaves other hooks alone).
printf '%s' "${existing}" | jq --argjson managed "${MANAGED}" --argjson hook "${HOOK_ENTRY}" '
  . * $managed
  | if any(.hooks.PreToolUse[]?.hooks[]?; (.command? // "") | endswith("/agent-attribution.sh"))
    then .
    else .hooks.PreToolUse = ((.hooks.PreToolUse // []) + [$hook])
    end'
